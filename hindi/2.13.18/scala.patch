diff --git a/verify-hi.sh b/verify-hi.sh
new file mode 100755
index 0000000000000000000000000000000000000000..1217f6dcfe1c6b3387fb0a074529b4f872262807
--- /dev/null
+++ b/verify-hi.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
+kojo_hi_java=${KOJO_HI_JAVA:-java}
+kojo_hi_cp="build/pack/lib/*"
+mkdir -p hi-tests/target
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "$kojo_hi_cp" scala.tools.nsc.Main \
+  -usejavacp -encoding UTF-8 -d hi-tests/target \
+  hi-tests/HindiKeywordsSmoke.scala hi-tests/HindiCompilerServicesSmoke.scala
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "hi-tests/target:$kojo_hi_cp" HindiKeywordsSmoke
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "hi-tests/target:$kojo_hi_cp" HindiCompilerServicesSmoke
+if "$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "$kojo_hi_cp" scala.tools.nsc.Main \
+    -usejavacp -encoding UTF-8 -d hi-tests/target hi-tests/HindiValReassignment.scala \
+    > hi-tests/target/val-reassignment.log 2>&1; then
+  echo 'FAIL: reassigning a Hindi val unexpectedly compiled' >&2
+  exit 1
+fi
+grep -q 'reassignment to val' hi-tests/target/val-reassignment.log
+echo 'Hindi val reassignment correctly rejected'
