diff --git a/hi-tests/HindiCompilerServicesSmoke.scala b/hi-tests/HindiCompilerServicesSmoke.scala
new file mode 100644
index 0000000000000000000000000000000000000000..72da0398a7bdac7d750b26e7f4cda961658e6561
--- /dev/null
+++ b/hi-tests/HindiCompilerServicesSmoke.scala
@@ -0,0 +1,49 @@
+import java.io.{PrintWriter, StringWriter}
+import scala.reflect.internal.util.BatchSourceFile
+import scala.tools.nsc.Settings
+import scala.tools.nsc.interactive.{Global, Response}
+import scala.tools.nsc.interpreter.{IMain, Results}
+import scala.tools.nsc.interpreter.shell.ReplReporterImpl
+import scala.tools.nsc.reporters.StoreReporter
+
+object HindiCompilerServicesSmoke {
+  def main(args: Array[String]): Unit = {
+    val settings = new Settings
+    settings.usejavacp.value = true
+    val output = new StringWriter
+    val interpreter = new IMain(settings, None, settings,
+      new ReplReporterImpl(settings, new PrintWriter(output)))
+    try {
+      for (code <- List("मान सीमा = 10", "चर गिनती = 0",
+          "परिभाषा दोगुना(संख्या: Int) = संख्या * 2",
+          "गिनती = दोगुना(सीमा)", "assert(गिनती == 20)",
+          "मान चयन = यदि (गिनती == 20) 1 अन्यथा 2", "assert(चयन == 1)",
+          "मान दूसरा = यदि (false) 1 अन्यथा यदि (true) 2 अन्यथा 3", "assert(दूसरा == 2)",
+          "assert((यदि (false) 1 else 2) == 2)", "assert((if (true) 1 अन्यथा 2) == 1)")) {
+        assert(interpreter.interpret(code) == Results.Success, code + "\n" + output)
+      }
+      println("Hindi interpreter smoke test passed")
+    } finally interpreter.close()
+
+    val reporter = new StoreReporter(settings)
+    val compiler = new Global(settings, reporter)
+    def await[A](response: Response[A]): A = response.get(30000L) match {
+      case Some(Left(value)) => value
+      case Some(Right(error)) => throw error
+      case None => throw new AssertionError("Presentation compiler timed out")
+    }
+    try {
+      val source = new BatchSourceFile("HindiPresentation.scala",
+        "object Demo { मान सीमा = 10; चर गिनती = 0; परिभाषा दोगुना(संख्या: Int) = संख्या * 2; गिनती = दोगुना(सीमा); मान चयन = यदि (गिनती > 0) दोगुना(गिनती) अन्यथा यदि (गिनती == 0) 0 अन्यथा -1 }")
+      val reload = new Response[Unit]
+      compiler.askReload(List(source), reload)
+      await(reload)
+      val typed = new Response[compiler.Tree]
+      compiler.askLoadedTyped(source, true, typed)
+      val tree = await(typed)
+      assert(!reporter.hasErrors, reporter.infos.mkString("\n"))
+      assert(tree.toString.contains("दोगुना"), tree.toString)
+      println("Hindi presentation compiler smoke test passed")
+    } finally compiler.askShutdown()
+  }
+}
diff --git a/hi-tests/HindiKeywordsSmoke.scala b/hi-tests/HindiKeywordsSmoke.scala
new file mode 100644
index 0000000000000000000000000000000000000000..170e7541c0f04bd36c548ccba1cca323a330a54e
--- /dev/null
+++ b/hi-tests/HindiKeywordsSmoke.scala
@@ -0,0 +1,61 @@
+object HindiKeywordsSmoke {
+  मान सीमा = 10
+  चर गिनती = 0
+  परिभाषा दोगुना(संख्या: Int): Int = संख्या * 2
+
+  class Counter(मान start: Int, चर current: Int) {
+    परिभाषा advance(): Int = { current += start; current }
+  }
+
+  def main(args: Array[String]): Unit = {
+    गिनती = दोगुना(सीमा)
+    assert(गिनती == 20)
+    assert(new Counter(2, 3).advance() == 5)
+    val मानक = 1
+    val चरित्र = 2
+    val परिभाषाएँ = 3
+    val `मान` = 4
+    val `चर` = 5
+    val `परिभाषा` = 6
+    assert(मानक + चरित्र + परिभाषाएँ + `मान` + `चर` + `परिभाषा` == 21)
+    // मान चर परिभाषा must remain comment text.
+    val text = "मान चर परिभाषा"
+    assert(text == List("मान", "चर", "परिभाषा").mkString(" "))
+    val message = s"गिनती: ${दोगुना(सीमा)}"
+    assert(message == "गिनती: 20")
+    परिभाषा चुनें(संख्या: Int): Int =
+      यदि (संख्या > 0) 1 अन्यथा यदि (संख्या == 0) 0 अन्यथा -1
+    assert(चुनें(2) == 1 && चुनें(0) == 0 && चुनें(-2) == -1)
+    for (condition <- List(true, false)) {
+      val expected = if (condition) 1 else 2
+      assert((यदि (condition) 1 अन्यथा 2) == expected)
+      assert((यदि (condition) 1 else 2) == expected)
+      assert((if (condition) 1 अन्यथा 2) == expected)
+    }
+    // A missing else returns Unit; a nested else belongs to the nearest if.
+    चर शाखा = 0
+    यदि (false) शाखा = 99
+    assert(शाखा == 0)
+    यदि (true) यदि (false) शाखा = 1 अन्यथा शाखा = 2
+    assert(शाखा == 2)
+    यदि (false) {
+      शाखा = 3
+    }
+    अन्यथा {
+      शाखा = 4
+    }
+    assert(शाखा == 4)
+    assert((यदि (true) 1 अन्यथा sys.error("unused else")) == 1)
+    assert((यदि (false) sys.error("unused if") अन्यथा 2) == 2)
+    val यदिविकल्प = 7
+    val अन्यथाविकल्प = 8
+    val `यदि` = 9
+    val `अन्यथा` = 10
+    assert(यदिविकल्प + अन्यथाविकल्प + `यदि` + `अन्यथा` == 34)
+    // यदि अन्यथा must remain comment text.
+    val conditionalText = "यदि अन्यथा"
+    assert(conditionalText == List("यदि", "अन्यथा").mkString(" "))
+    assert(s"result: ${यदि (true) 1 अन्यथा 2}" == "result: 1")
+    println("Hindi compiler smoke test passed")
+  }
+}
