+#!/usr/bin/env bash
+set -euo pipefail
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
+kojo_hi_java=${KOJO_HI_JAVA:-java}
+kojo_hi_cp="../scala/build/pack/lib/scala-library.jar:../scala/build/pack/lib/scala-reflect.jar:../scala/build/pack/lib/scala-compiler.jar:hi-build/target/scala-2.13/scalariform.jar:hi-build/target/runtime-dependencies/*"
+mkdir -p hi-tests/target
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "$kojo_hi_cp" scala.tools.nsc.Main \
+  -usejavacp -encoding UTF-8 -d hi-tests/target hi-tests/ScalariformSmoke.scala
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "hi-tests/target:$kojo_hi_cp" ScalariformSmoke \
+  ../scala/hi-tests/HindiKeywordsSmoke.scala hi-tests/target/HindiKeywordsSmoke.scala
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "$kojo_hi_cp" scala.tools.nsc.Main \
+  -usejavacp -encoding UTF-8 -d hi-tests/target hi-tests/target/HindiKeywordsSmoke.scala
+"$kojo_hi_java" -Dfile.encoding=UTF-8 -cp "hi-tests/target:$kojo_hi_cp" HindiKeywordsSmoke
