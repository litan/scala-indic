diff --git a/scalariform/src/test/scala/scalariform/lexer/HindiKeywordsTest.scala b/scalariform/src/test/scala/scalariform/lexer/HindiKeywordsTest.scala
new file mode 100644
index 0000000000000000000000000000000000000000..6d0ce3490d2e42471bff9158c63625ae2caca877
--- /dev/null
+++ b/scalariform/src/test/scala/scalariform/lexer/HindiKeywordsTest.scala
@@ -0,0 +1,61 @@
+package scalariform.lexer
+
+import org.scalatest.{FlatSpec, Matchers}
+import scalariform.formatter.ScalaFormatter
+import scalariform.lexer.Tokens._
+
+class HindiKeywordsTest extends FlatSpec with Matchers {
+  "Hindi keywords" should "use existing tokens and retain source text and offsets" in {
+    val source = "मान सीमा = 10\nचर गिनती = 0\nपरिभाषा दोगुना(संख्या: Int) = यदि (संख्या > 0) संख्या * 2 अन्यथा 0"
+    val tokens = ScalaLexer.rawTokenise(source).filterNot(t => t.tokenType == WS || t.tokenType == EOF)
+    for ((word, kind) <- Seq("मान" -> VAL, "चर" -> VAR, "परिभाषा" -> DEF, "यदि" -> IF, "अन्यथा" -> ELSE)) {
+      val token = tokens.find(_.text == word).get
+      token.tokenType should equal(kind)
+      token.rawText should equal(word)
+      source.substring(token.offset, token.offset + token.length) should equal(word)
+    }
+  }
+
+  it should "leave longer identifiers, backquoted identifiers, comments and strings intact" in {
+    val source = "मानक चरित्र परिभाषाएँ यदिविकल्प अन्यथाविकल्प `मान` `चर` `परिभाषा` `यदि` `अन्यथा` \"मान चर परिभाषा यदि अन्यथा\" // मान चर परिभाषा यदि अन्यथा"
+    val tokens = ScalaLexer.rawTokenise(source).filterNot(t => t.tokenType == WS || t.tokenType == EOF)
+    tokens.take(10).map(_.tokenType) should equal(List.fill(10)(VARID))
+    tokens(10).tokenType should equal(STRING_LITERAL)
+    tokens(10).text should equal("\"मान चर परिभाषा यदि अन्यथा\"")
+    tokens(11).tokenType should equal(LINE_COMMENT)
+    tokens(11).text should equal("// मान चर परिभाषा यदि अन्यथा")
+  }
+
+  it should "format Hindi and English together without rewriting words" in {
+    val source = "object Demo{मान सीमा=10;चर गिनती=0;परिभाषा दोगुना(संख्या:Int)=संख्या*2;def english(x:Int)=दोगुना(x);val text=\"मान चर परिभाषा\";/* मान चर परिभाषा */}"
+    val formatted = ScalaFormatter.format(source)
+    formatted should include("मान सीमा = 10")
+    formatted should include("चर गिनती = 0")
+    formatted should include("परिभाषा दोगुना(संख्या: Int) = संख्या * 2")
+    formatted should include("def english(x: Int) = दोगुना(x)")
+    formatted should include("\"मान चर परिभाषा\"")
+    formatted should include("/* मान चर परिभाषा */")
+    ScalaFormatter.format(formatted) should equal(formatted)
+  }
+
+  it should "format conditional forms while preserving Hindi and English keywords" in {
+    val sources = Seq(
+      "val result=यदि(true)1 अन्यथा 2",
+      "val result=यदि(false)1 else 2",
+      "val result=if(true)1 अन्यथा 2",
+      "val result=if(false)1 else 2",
+      "val result=यदि(false)1 अन्यथा यदि(true)2 अन्यथा 3",
+      "यदि(true)यदि(false)println(1) अन्यथा println(2)",
+      "यदि(false)println(1)",
+      "यदि(true){println(1)}\nअन्यथा{println(2)}"
+    )
+    def conditionalWords(source: String): List[String] =
+      ScalaLexer.rawTokenise(source).filter(t => t.tokenType == IF || t.tokenType == ELSE).map(_.text)
+    for (source <- sources) {
+      val formatted = ScalaFormatter.format(source)
+      conditionalWords(formatted) should equal(conditionalWords(source))
+      ScalaFormatter.format(formatted) should equal(formatted)
+    }
+    ScalaFormatter.format("val result=यदि(true)1 अन्यथा 2") should equal("val result = यदि (true) 1 अन्यथा 2")
+  }
+}
