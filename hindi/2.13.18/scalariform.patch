@@ -0,0 +1,22 @@
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.{Files, Paths}
+import scalariform.formatter.ScalaFormatter
+import scalariform.lexer.{ScalaLexer, Tokens}
+
+object ScalariformSmoke {
+  def main(args: Array[String]): Unit = {
+    val original = new String(Files.readAllBytes(Paths.get(args(0))), UTF_8)
+    val formatted = ScalaFormatter.format(original)
+    for ((word, kind) <- List("मान" -> Tokens.VAL, "चर" -> Tokens.VAR, "परिभाषा" -> Tokens.DEF,
+        "यदि" -> Tokens.IF, "अन्यथा" -> Tokens.ELSE)) {
+      assert(ScalaLexer.rawTokenise(formatted).exists(t => t.text == word && t.tokenType == kind), word)
+    }
+    assert(ScalaFormatter.format(formatted) == formatted)
+    assert(formatted.contains("\"मान चर परिभाषा\""))
+    assert(formatted.contains("// मान चर परिभाषा"))
+    assert(formatted.contains("\"यदि अन्यथा\""))
+    assert(formatted.contains("// यदि अन्यथा"))
+    Files.write(Paths.get(args(1)), formatted.getBytes(UTF_8))
+    println("Hindi formatter jar smoke test passed")
+  }
+}
